<?xml version="1.0" encoding="utf-8"?>
<!-- Recent calls (W11): from 2x2 up to the whole screen; the list scrolls.
     Refreshed after every call and when ZT Phone opens; the half-hourly
     update keeps "Yesterday" right. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_recent_calls"
    android:previewLayout="@layout/widget_recent_calls_preview"
    android:description="@string/widget_recents_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen">
</appwidget-provider>
