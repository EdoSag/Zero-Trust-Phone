<?xml version="1.0" encoding="utf-8"?>
<!-- One call in the recent calls widget: direction icon, who, when. Tap
     opens the dialpad with the number, one more tap calls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="6dp">
    <LinearLayout
        android:id="@+id/call_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@drawable/zt_widget_tile"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/call_row_type"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_call_received"
            android:tint="@color/zt_widget_on_surface_variant"
            android:importantForAccessibility="no"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/call_row_name"
                style="@style/ZtWidget.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textDirection="locale"/>
            <TextView
                android:id="@+id/call_row_when"
                style="@style/ZtWidget.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_zt_widget_call"
            android:tint="@color/zt_widget_accent"
            android:importantForAccessibility="no"/>
    </LinearLayout>
</FrameLayout>
