<?xml version="1.0" encoding="utf-8"?>
<!--
  Recent calls widget (W11), in the shared Zero-Trust widget look
  (Zero-Trust-Core/android-widget-kit). RecentCallsWidget fills the list
  from Android's call log only while "Show details on the home screen" is
  on; otherwise it shows the lock panel with the missed-call count.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recents_root"
    style="@style/ZtWidget.Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/recents_app_icon"
            android:layout_width="@dimen/zt_widget_header_icon"
            android:layout_height="@dimen/zt_widget_header_icon"
            android:src="@mipmap/ic_launcher"
            android:importantForAccessibility="no"/>
        <LinearLayout
            android:id="@+id/recents_switch"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/recents_title"
                style="@style/ZtWidget.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_recents"/>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_zt_widget_dropdown"
                android:tint="@color/zt_widget_on_surface_variant"
                android:importantForAccessibility="no"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/recents_dialpad"
            style="@style/ZtWidget.Action"
            android:src="@drawable/ic_widget_dialpad"
            android:contentDescription="@string/widget_dialpad"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">
        <ListView
            android:id="@+id/recents_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none"/>
        <TextView
            android:id="@+id/recents_empty"
            style="@style/ZtWidget.Caption"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/widget_no_calls"
            android:visibility="gone"/>
        <LinearLayout
            android:id="@+id/recents_locked"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/zt_widget_tile_circle">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_zt_widget_lock"
                    android:tint="@color/zt_widget_on_surface_variant"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <TextView
                android:id="@+id/recents_missed_count"
                style="@style/ZtWidget.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxLines="1"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/recents_locked_text"
                style="@style/ZtWidget.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="4"
                android:text="@string/widget_recents_hidden"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
